# The account-activity warehouse (Postgres). In production this is the customer's warehouse in
# AWS us-east-1, reached with short-lived Vault-minted credentials.
WAREHOUSE_DATABASE_URL=postgres://user:password@host:5432/warehouse

# The copilot's own derived state: brief runs, per-run cost, citations and the evidence ledger.
APPSTORE_DATABASE_URL=postgres://user:password@host:5432/appstore

# AI Gateway credential for local development. In production the agent uses Vercel OIDC instead,
# so no provider key is needed. Locally, set this or run `vercel link` to pull an OIDC token.
AI_GATEWAY_API_KEY=
