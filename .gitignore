dist
.DS_Store
*.tsbuildinfo

# Local agent tooling. skills-lock.json is kept as the record of which skills were used;
# the vendored skill files themselves are not part of this project.
.claude/
.agents/

# Terraform. State stays out of git: it is local only until the HCP Terraform workspace takes it
# over, and even then it carries resource metadata that does not belong in a repo. The provider
# lock file is the exception and is committed on purpose, so a plan resolves the same providers
# here as it does in the remote workspace.
**/.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfvars
!*.tfvars.example
